SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/availability
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
DRY_RUN=true
WIW_MODE=demo
WIW_TOKEN=
WIW_CONTEXT_USER_ID=0
WIW_ACCOUNT_ID=0
BUSINESS_TIMEZONE=America/New_York
MINIMUM_NOTICE_DAYS=1
SESSION_HOURS=8
WIW_DEVELOPER_KEY=

# Maximum weekly submissions per employee in a rolling 30 days; 0 = unlimited.
AVAILABILITY_REQUEST_LIMIT_30_DAYS=0

# Automatically grant employee access to verified active workplace members.
WIW_AUTO_ENROLL=false
WIW_AUTO_ENROLL_LOCATION=

# Email stays disabled until a shared mailbox transport and public URL are configured.
EMAIL_ENABLED=false
EMAIL_FROM=alerts@rva7brew.com
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# false uses mandatory STARTTLS; true uses TLS from connection start (usually port 465).
SMTP_SSL=false

# Microsoft 365 shared mailbox (preferred for alerts@rva7brew.com)
EMAIL_PROVIDER=microsoft_graph
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# WIW-generated webhook signing secret; only required on the web service.
WIW_WEBHOOK_SECRET=

# Keep enabled for automatic service-token renewal.
WIW_AUTO_REFRESH=true
